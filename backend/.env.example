# Server
NODE_ENV=production
PORT=5001
CLIENT_URL=http://YOUR_SERVER_IP

# Auto-deploy webhook (GitHub Actions → POST /api/deploy/webhook). Use a long random string.
# DEPLOY_WEBHOOK_SECRET=
# EXAMIA_DIR=/var/www/examia

# MongoDB (must match variable name used in code: MONGODB_URI)
# For Atlas/replica sets: avoid readPreference=secondary on the app URI, or new quizzes may not appear immediately after publish.
MONGODB_URI=mongodb://localhost:27017/your-database-name
# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Teach & Learn voice call (natural speech, ChatGPT-style)
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova

# SMTP (e.g. Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password1